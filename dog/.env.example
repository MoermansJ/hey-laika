# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

ENVIRONMENT=development
# DEBUG=True enables the Werkzeug interactive debugger — never on a port
# other machines can reach. HOST is the bind address for the native
# `python -m app.app` run (Docker/gunicorn binds 0.0.0.0 on its own).
DEBUG=False
HOST=127.0.0.1

# Which robot instance this service is the adapter for (must match the
# orchestrator's registration for this service).
ROBOT_ID=bittle-1

# Hardware: mock | serial | wifi
# wifi speaks WebSocket to the BiBoard's stock firmware (ws://<host>:81);
# serial is USB (validated over COM3 at 115200).
MOCK_MODE=True
BITTLE_COMMUNICATION_METHOD=mock
BITTLE_SERIAL_PORT=COM3
BITTLE_SERIAL_BAUD=115200
BITTLE_WIFI_HOST=192.168.0.246
BITTLE_WIFI_PORT=81

# AI decision engine: ollama (default — the local model, zero cost) |
# claude (requires ANTHROPIC_API_KEY; the app raises a missing-credentials
# error without it) | mock (explicit offline simulated engine).
DECISION_ENGINE=ollama
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Voice feature ("Hey Laika") — local Ollama LLM + optional Eleven Labs TTS.
# llama3.2:1b is the deliberately light temporary model; swap for something
# bigger (e.g. mistral) when the voice hardware arrives.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=60
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Database
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./bittle.db

# Persistence
PERSISTENCE_ENABLED=True
SAVE_CONVERSATION_HISTORY=True
SAVE_BEHAVIOR_LOG=True

# Autonomous behavior loop interval (seconds)
AUTONOMOUS_INTERVAL=15

# Ears / mouth (VOICE_RELAY_BRIEF): the XIAO satellite streams PCM to
# EARS_UDP_PORT; whisper runs on the host. SPEAKER_PIN / ULTRASONIC_PIN are
# the UART-socket GPIOs (9 or 10), set them once the wiring is known.
EARS_ENABLED=True
EARS_UDP_PORT=5005
WAKE_PHRASE=hey laika
# Speech gate on DC-free RMS of each 20 ms packet; GET /ears -> level shows
# the live rms/peak/median. Fan noise on the head measured ~50-100 median,
# ~160-290 peak; quiet speech ~370, normal speech 1000-2400 (2026-09-05).
EARS_ENERGY_FLOOR=300
WHISPER_MODEL=base
SPEAKER_PIN=
ULTRASONIC_PIN=

# XIAO satellite on its own WiFi address: camera (eyes.py, YOLOv8n ONNX
# from dog/tools/export_yolo.py) and the chainable RGB mood light (mood.py).
# Empty = no satellite; eyes and mood report disabled.
SATELLITE_HOST=
EYES_ENABLED=True
EYES_FPS=4
EYES_CONFIDENCE=0.45
MOOD_ENABLED=True
