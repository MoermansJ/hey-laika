# Copy to .env next to docker-compose.yml. Values are injected into the
# Python adapter containers; the orchestrator itself never sees the API key.

# Required only when DECISION_ENGINE=claude: the Python adapters raise a
# missing-credentials error without it.
ANTHROPIC_API_KEY=

# ollama | claude | mock — ollama (default) decides via the local model in
# the ollama container (zero cost); mock = explicit offline simulation.
DECISION_ENGINE=ollama

# True = simulate the robot; False (default) = drive real hardware
MOCK_MODE=False

# mock | serial | wifi — wifi (default) speaks WebSocket to the BiBoard's
# stock firmware. serial needs a COM port, which Docker on Windows cannot
# pass through — run the adapter natively for that.
BITTLE_COMMUNICATION_METHOD=wifi

# BiBoard IP on your LAN (DHCP — keep a router reservation for it)
BITTLE_WIFI_HOST=192.168.0.246

# Grove UART socket wiring (validate per docs/design/ARRIVAL_DAY_RUNBOOK.md).
# 0 or unset = not wired. Laika: ranger SIG on GPIO 9, speaker on GPIO 10.
ULTRASONIC_PIN=9
SPEAKER_PIN=

# XIAO satellite (camera + mood light) on its own WiFi address; keep a
# router reservation for it too. Empty = no satellite.
SATELLITE_HOST=
