# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

ENVIRONMENT=development
DEBUG=True

# Hardware: mock | serial | wifi
MOCK_MODE=True
BITTLE_COMMUNICATION_METHOD=mock
BITTLE_SERIAL_PORT=COM3
BITTLE_WIFI_HOST=192.168.1.100

# Anthropic / Claude
# Leave empty to run with the simulated (mock) decision engine.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Database
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./bittle.db

# Persistence
PERSISTENCE_ENABLED=True
SAVE_CONVERSATION_HISTORY=True
SAVE_BEHAVIOR_LOG=True

# Autonomous behavior loop interval (seconds)
AUTONOMOUS_INTERVAL=15
