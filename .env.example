# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

ENVIRONMENT=development
DEBUG=True

# Which robot instance this service is the adapter for (must match the
# orchestrator's registration for this service).
ROBOT_ID=bittle-1

# Hardware: mock | serial | wifi
MOCK_MODE=True
BITTLE_COMMUNICATION_METHOD=mock
BITTLE_SERIAL_PORT=COM3
BITTLE_WIFI_HOST=192.168.1.100

# Anthropic / Claude
# DECISION_ENGINE=claude requires ANTHROPIC_API_KEY (the app raises a
# missing-credentials error without it). Set DECISION_ENGINE=mock to
# explicitly run the offline simulated engine instead.
DECISION_ENGINE=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Voice feature ("Hey Laika") — local Ollama LLM + optional Eleven Labs TTS.
# llama3.2:1b is the deliberately light temporary model; swap for something
# bigger (e.g. mistral) when the voice hardware arrives.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=60
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Database
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./bittle.db

# Persistence
PERSISTENCE_ENABLED=True
SAVE_CONVERSATION_HISTORY=True
SAVE_BEHAVIOR_LOG=True

# Autonomous behavior loop interval (seconds)
AUTONOMOUS_INTERVAL=15
