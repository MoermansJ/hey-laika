# Copy to .env next to docker-compose.yml. Values are injected into the
# Python adapter containers; the orchestrator itself never sees the API key.

# Required when DECISION_ENGINE=claude (the default): the Python adapters
# raise a missing-credentials error without it.
ANTHROPIC_API_KEY=

# claude | mock  (mock = explicit offline simulation, no API key needed)
DECISION_ENGINE=claude

# True = simulate the robot; False (default) = drive real hardware
MOCK_MODE=False

# mock | serial | wifi — wifi (default) speaks WebSocket to the BiBoard's
# stock firmware. serial needs a COM port, which Docker on Windows cannot
# pass through — run the adapter natively for that.
BITTLE_COMMUNICATION_METHOD=wifi

# BiBoard IP on your LAN (DHCP — keep a router reservation for it)
BITTLE_WIFI_HOST=192.168.0.246
